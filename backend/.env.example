NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# Opcion A (recomendada, con Supabase): pega aqui la cadena de conexion completa
# que te da Supabase en Project Settings -> Database -> Connection string ->
# modo "Session" o "Transaction". Se ve algo asi:
# postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Si las tablas de este proyecto viven en un schema propio dentro de un
# proyecto Supabase compartido con otras apps (en vez del schema "public"),
# indica aqui el nombre de ese schema. Por defecto: la_preparatoria.
DB_SCHEMA=la_preparatoria

# Opcion B (Postgres local, sin Supabase): deja DATABASE_URL vacio y usa esto
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=la_preparatoria
DATABASE_SSL=false

JWT_SECRET=cambia_esta_clave_por_una_bien_larga_y_aleatoria
JWT_EXPIRES_IN=8h
